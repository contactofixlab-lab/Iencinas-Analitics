# ── Seguridad (OBLIGATORIO en producción) ─────────────────────────────────
# Clave para firmar las sesiones. Mínimo 32 caracteres, aleatoria y secreta.
# Generar una:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# ── Origen de datos ───────────────────────────────────────────────────────
DATA_SOURCE=mock
# CRM_API_BASE_URL=https://api.tu-crm.com
# CRM_API_KEY=
# CRM_API_AUTH_SCHEME=bearer
# CRM_API_KEY_HEADER=x-api-key
# CRM_API_TIMEOUT_MS=10000
# CRM_FALLBACK_TO_MOCK=true

# ── Cuentas de demostración ───────────────────────────────────────────────
# Las cuentas semilla (juan@, maria@, carlos@, ana@iencinas.cl) traen una contraseña inicial
# conocida. En producción están DESHABILITADAS hasta que se cambie su contraseña.
# Solo para una demo pública, activar explícitamente (inseguro):
# ALLOW_DEMO_ACCOUNTS=true
